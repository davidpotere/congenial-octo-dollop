# Copy to .env (never commit .env). Every source is optional: leave a value blank and that source is skipped.
TEMPEST_TOKEN=
ANTHROPIC_API_KEY=
HAIKUBOX_SERIAL=
BIRDBUDDY_EMAIL=
BIRDBUDDY_PASSWORD=
ARLO_USERNAME=
ARLO_PASSWORD=
# Arlo 2FA codes are read from the inbox they are sent to (IMAP). For Gmail use an App Password.
ARLO_TFA_IMAP_HOST=imap.gmail.com
ARLO_TFA_IMAP_USER=
ARLO_TFA_IMAP_PASSWORD=
EBIRD_API_KEY=
# Gmail sending (App Password: myaccount.google.com/apppasswords)
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
# Phone push via ntfy (install the ntfy app and subscribe to this topic; pick a long random name)
NTFY_TOPIC=
NTFY_TOKEN=
